# Base de données (Supabase Postgres)
# Connexion Transaction Pooler (port 6543) pour le runtime serverless Vercel
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connexion directe (port 5432) pour les migrations Prisma uniquement
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Attention : SUPABASE_SERVICE_ROLE_KEY côté serveur uniquement (jamais NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Chiffrement applicatif (AES-256-GCM) & Hachage sécurisé
APP_SECRET="local-dev-secret-encryption-key-at-least-32-chars-long-12345678"
PEPPER="local-dev-pepper-salt-key-16-chars!"

# E-mail transactionnel (Resend)
RESEND_API_KEY="re_test_key"
NOTIFICATION_EMAIL_FROM="Ma boîte à prière <alertes@maboiteapriere.fr>"
ADMIN_ALERT_EMAIL="pastorale@maboiteapriere.fr"

# Protection anti-spam & limitation de débit (optionnels en local)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sécurité Cron (Vercel Cron)
CRON_SECRET="local-dev-cron-secret-key-16-chars!"

# Environnement
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
